      <aliases enabled='yes' />
      <column caption='Ranks_Calculation' datatype='integer' name='[Calculation_469218794974195714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Sales]),&apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='ProfitLoss' datatype='integer' datatype-customized='true' name='[Calculation_469218794991902732]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='INT(IF ISNULL(SUM([Profit])) THEN &quot;No Data&quot;&#13;&#10;ELSEIF SUM([Profit]) &gt;= 0 THEN &quot;+&quot; + STR(SUM([Profit]))&#13;&#10;ELSE &quot;-&quot; + STR(ABS(SUM([Profit])))&#13;&#10;END)' />
      </column>
      <column caption='Avg_discount' datatype='real' name='[Calculation_469218795000279054]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Discount])' />
      </column>
      <column caption='Avg_profit_ratio' datatype='real' name='[Calculation_469218795000578063]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Profit Ratio])' />
      </column>
      <column caption='Sum_quantity' datatype='integer' name='[Calculation_469218795000721424]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Quantity])' />
      </column>
